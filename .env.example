# Port Configuration
FRONTEND_PORT=5173
BACKEND_PORT=3000
AI_SERVICES_PORT=5000
OLLAMA_PORT=11434
DB_PORT=5432
REDIS_PORT=6379

# Database Configuration
DB_USER=admin
DB_PASSWORD=your_secure_password_here
